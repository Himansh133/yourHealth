DATABASE_URL=postgresql+psycopg://yourhealth:yourhealth@localhost:5432/yourhealth
TEST_DATABASE_URL=postgresql+psycopg://yourhealth:yourhealth@localhost:5432/yourhealth_test
JWT_SECRET=  # required, 32+ chars: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
COOKIE_SECURE=false  # local http only; keep true behind HTTPS
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=yourhealth
S3_SECRET_KEY=yourhealth-dev-secret
S3_BUCKET=yourhealth-docs
REDIS_URL=redis://localhost:6379/0
LLM_BASE_URL=https://api.gmi-serving.com/v1
LLM_API_KEY=  # from the GMI Cloud console; never commit it
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_THINKING=false
PUBLIC_BASE_URL=http://localhost:5173  # where the frontend is served; share links and QR codes point here
# WhatsApp Cloud API (Meta developer app -> WhatsApp). Leave empty to run without the bot.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=  # signs every webhook POST; required, or the webhook rejects everything
WA_VERIFY_TOKEN=  # any string you choose; enter the same one in Meta's webhook settings
WA_GRAPH_VERSION=v23.0  # check Meta's docs for the current version
WA_DISPLAY_NUMBER=  # the bot's number as people should type it, e.g. +1 555 0100

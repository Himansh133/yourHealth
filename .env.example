DATABASE_URL=postgresql+psycopg://yourhealth:yourhealth@localhost:5432/yourhealth
TEST_DATABASE_URL=postgresql+psycopg://yourhealth:yourhealth@localhost:5432/yourhealth_test
JWT_SECRET=  # required, 32+ chars: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
COOKIE_SECURE=false  # local http only; keep true behind HTTPS
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=yourhealth
S3_SECRET_KEY=yourhealth-dev-secret
S3_BUCKET=yourhealth-docs
